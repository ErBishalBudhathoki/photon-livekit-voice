# Rendered from the templates - never commit the real ones. Anchor to the repo
# root: an unanchored "docker-compose.yaml" also hides templates/docker-compose.yaml.
/livekit.yaml
/sip.yaml
/docker-compose.yaml
/.env

# Credentials and certificates.
certs/
*.pem
*.key
*.crt

# Call transcripts: they contain real conversations.
calls/
*.jsonl

# Build and runtime artefacts.
venv/
__pycache__/
*.pyc
*.log
*.bak
*.bak.*
.uv/

# Local-only: install identifiers the scanner refuses to see in tracked files.
/.secretscan

# Credential and key files of every kind, plus editor/OS droppings.
*.env
!/.env.example
id_rsa*
id_ed25519*
.netrc
.pgpass
*.session
*.p12
*.pfx
*.jks
*.ovpn
.DS_Store
*.swp
.pytest_cache/
