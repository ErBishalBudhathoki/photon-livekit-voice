# photon-livekit-voice configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# This file is the single source of truth for both the docker stack (docker
# compose reads it automatically) and the python pieces (agent/env.py loads it).
# It ends up holding live credentials, so keep it 600 and never commit it.
#
# Nothing here is printed by the bootstrap scripts: they report lengths and
# masked values only, so a failing gate can be pasted into a chat or an issue
# without leaking a password.

# ---------------------------------------------------------------- host identity
# The public name the carrier sends calls to, and the name its certificate must
# cover. SIP cannot cross a Cloudflare proxy: the DNS record for this name MUST
# be grey-cloud (DNS only). An orange-clouded record breaks SIP silently - the
# A record resolves to Cloudflare's edge and no INVITE ever reaches this host.
SIP_DOMAIN=sip.example.com
# Public IP of this host. Left empty, bootstrap/00-preflight.py looks it up and
# checks that SIP_DOMAIN actually resolves to it.
PUBLIC_IP=
# Contact address for the ACME account that issues the SIP certificate.
ACME_EMAIL=you@example.com
# Only needed for DNS-01 issuance (recommended: it never opens port 80). A
# Cloudflare API token with Zone:DNS:Edit on the SIP_DOMAIN's zone.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------- LiveKit
# Generated by bootstrap/10-stack.sh when empty (openssl rand) and written back
# here. Leave blank on a fresh install.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://127.0.0.1:7880
# Pinned: the stack is drift-sensitive, and a silent minor bump has broken SIP
# trunk handling before. Bump deliberately, then re-run the ladder.
LIVEKIT_SERVER_TAG=v1.13.10
LIVEKIT_SIP_TAG=v1.19.0

# ----------------------------------------------------------------- ports / media
# 6379 is left alone on purpose - it is commonly taken by a host Redis/Valkey.
# LiveKit keeps trunk and room state here, so it is NOT a cache.
REDIS_PORT=6380
LIVEKIT_API_PORT=7880
RTC_TCP_PORT=7881
RTC_UDP_PORT=7882
SIP_PORT=5060
SIP_TLS_PORT=5061
# The RTP range. Open exactly this range inbound in BOTH the cloud security list
# and the host firewall, or calls connect with no audio.
RTP_PORT_RANGE=10000-10100
# Paths as seen INSIDE the sip container.
TLS_CERT_FILE=/certs/sip.crt
TLS_KEY_FILE=/certs/sip.key

# ---------------------------------------------------------------- voice agent
# Gemini Live API key (speech-to-speech). A free-tier key is bound by
# tokens-per-minute, not requests: two overlapping live sessions trip
# error 1011 "Resource has been exhausted" and the caller hears silence.
# GEMINI_LIVE_API_KEY and GOOGLE_API_KEY are accepted as aliases.
GEMINI_API_KEY=
AGENT_S2S_MODEL=gemini-3.8-live
AGENT_S2S_VOICE=Puck
AGENT_WORKER_PORT=8083
# Shown to the model so it knows whose assistant it is; free text.
AGENT_OWNER_LABEL="the owner"
# The SIP participant identity the dialer uses for the phone leg. The worker
# waits for exactly this identity before it speaks, so both sides read it here.
SIP_IDENTITY=phone-user
SIP_PARTICIPANT_NAME=Phone User
# Where the worker writes one JSON-lines transcript per call. Empty = <repo>/calls.
# The chat briefing is built from these, and /calllog reprints them.
AGENT_CALL_LOG_DIR=

# ------------------------------------------------------- how the agent behaves
# The floor on an outbound call: end_call is refused until the agent has spoken
# and the line has been up this long. Without it a model told to "wrap up" wraps
# up one second in.
AGENT_MIN_TALK_S=12
# A "this is a machine" verdict may end the call earlier than MIN_TALK_S, but not
# before this - anything sooner is the model being impatient, not a voicemail.
AGENT_MACHINE_MIN_S=6
# Keep the line up briefly after end_call so the farewell is not cut off.
AGENT_HANGUP_GRACE_S=3.5
# Optional file of extra instructions appended to the persona.
AGENT_PERSONA_FILE=
# Optional first line for an inbound call. Empty = let the model open.
AGENT_INBOUND_GREETING=

# --------------------------------------------------------------------- numbers
# The number /callme rings (your own). E.164.
OWNER_NUMBER=+15551234567
# The provider's number - the caller ID outbound calls present, and the number
# the inbound trunk owns. bootstrap/20-sip-objects.py reads it from the provider
# API if left empty, but setting it explicitly is what makes the trunk's number
# list reliable.
SIP_INBOUND_NUMBER=+15551234567
# Country code used to expand local-form numbers typed into /call and the dialer
# (0456789012 -> +61456789012 with 61). Leave empty to require full E.164.
DEFAULT_COUNTRY_CODE=1

# ---------------------------------------------------------------- SIP objects
# Names created by bootstrap/20-sip-objects.py and 30-photon.py. Rename them here
# if they clash with objects you already have.
SIP_INBOUND_TRUNK=photon-inbound
SIP_DISPATCH_RULE=photon-inbound
SIP_OUTBOUND_TRUNK=photon-outbound
ROOM_PREFIX=call-
# Optional: restrict inbound calls to these carrier IPs/CIDRs (comma separated).
# Empty means any source that can complete the digest challenge.
SIP_ALLOWED_ADDRESSES=

# ------------------------------------------------------------ provider: Photon
# Photon voice-eligible line required: the profile must report lineCount > 0.
# A project with no line cannot make or take calls, and nothing here can create
# one for you - that is an account step in the Photon dashboard.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_VOICE_PROFILE_ID=
# Credentials bootstrap/20-sip-objects.py generates for the carrier and
# 30-photon.py hands to Photon. Filled in on first run; do not edit by hand.
SIP_INBOUND_USER=
SIP_INBOUND_PASS=
# Outbound credential Photon issues for its SBC, plus the endpoint it chose.
# Filled in by 30-photon.py.
SIP_OUTBOUND_HOST=
SIP_OUTBOUND_PORT=
SIP_OUTBOUND_TRANSPORT=
SIP_OUTBOUND_USER=
SIP_OUTBOUND_PASS=
SIP_OUTBOUND_REALM=
SIP_OUTBOUND_ALL_ENDPOINTS=

# --------------------------------------------------------------- delegation
# DANGEROUS, and OFF by default. When on, the agent can hand a live caller's
# request to a local Hermes agent session and speak the answer back. An inbound
# caller is then able to run whatever that session can run, so enabling this
# requires an explicit caller-ID allowlist below.
AGENT_DELEGATION_ENABLED=false
# Comma-separated; compared on the last 9 digits, because the caller-ID a carrier
# delivers rarely matches the format typed here.
AGENT_DELEGATION_ALLOWLIST=
AGENT_HERMES_BIN=hermes
AGENT_HERMES_SESSION=phone
AGENT_HERMES_TIMEOUT=120
