# photon-livekit-voice configuration
# =============================================================================
# Every value this stack needs lives in THIS file, copied to .env. Nothing is
# read from anywhere else - the docker stack, the bootstrap gates, the worker and
# the chat surface all load .env.
#
#   cp .env.example .env && chmod 600 .env
#
# .env holds live credentials. It is gitignored, every script that writes it
# chmods it 600, and `scripts/secret-scan.py` refuses to publish its values.
#
# -----------------------------------------------------------------------------
# SAMPLE VALUES - shapes and provenance, never real keys. Anything marked
# "generated" must be left BLANK here; the installer fills it in.
#
#   SIP_DOMAIN              sip.example.com         your DNS name, grey-cloud A record
#   LIVEKIT_API_KEY         API + 12 chars          generated by 10-stack.sh
#   LIVEKIT_API_SECRET      44 chars                generated by 10-stack.sh
#   GEMINI_API_KEY          AIza + 35 chars         aistudio.google.com/apikey
#   PHOTON_API_KEY          opaque                  provider dashboard
#   PHOTON_PROJECT_ID       pho_prj_ + 26 chars     provider dashboard URL
#   PHOTON_VOICE_PROFILE_ID pho_vpf_ + 26 chars     provider dashboard URL
#   SIP_INBOUND_USER        stable local part       generated by 20-sip-objects.py
#   SIP_INBOUND_PASS        43 chars                generated by 20-sip-objects.py
#   SIP_OUTBOUND_*          issued by the provider  written by 30-photon.py
#
# Two rules that cost the most time when broken:
#   * the DNS record for SIP_DOMAIN must be DNS-only (grey cloud). A proxied
#     record resolves to the CDN, no INVITE ever arrives, and nothing logs an
#     error.
#   * the RTP range must be open inbound in BOTH the cloud security list and the
#     host firewall, or calls connect and carry no audio.
# =============================================================================


# =========================================================== host identity
# REQUIRED. The public name the carrier sends calls to, and the name the SIP
# certificate must cover. No trailing dot, no scheme.
SIP_DOMAIN=sip.example.com

# RECOMMENDED. This host's public IPv4. Leave empty and gate 0 looks it up and
# checks that SIP_DOMAIN resolves to it.
# sample: 203.0.113.10
PUBLIC_IP=

# REQUIRED for certificate issuance. ACME contact address (the CA emails you here
# if issuance starts failing). Any address you control.
# sample: ops@example.com
ACME_EMAIL=

# OPTIONAL. Only used for DNS-01 issuance, which is the recommended path because
# it never opens port 80. A provider API token with Zone:DNS:Edit on the zone of
# SIP_DOMAIN. Leave empty to use HTTP-01 instead (then port 80 must be reachable).
# sample: a 40-character API token
CLOUDFLARE_API_TOKEN=


# ================================================================ LiveKit
# GENERATED. Leave both blank on a fresh install; gate 1 creates the keypair with
# openssl rand and writes it back here. The same values are rendered into
# livekit.yaml, sip.yaml and the compose file, so changing one by hand breaks the
# stack: change them here and re-run gate 1.
# sample: API + 12 alphanumerics
LIVEKIT_API_KEY=
# sample: 44 random characters
LIVEKIT_API_SECRET=

# The API endpoint every python piece dials. Keep loopback unless you know why.
LIVEKIT_URL=ws://127.0.0.1:7880

# PINNED on purpose. The stack is drift-sensitive - the answered-gate reads a
# protocol-level participant attribute - so bump deliberately and re-run the
# ladder (bootstrap/90-check.py) afterwards.
LIVEKIT_SERVER_TAG=v1.13.10
LIVEKIT_SIP_TAG=v1.19.0


# ========================================================== ports and media
# Defaults are fine for a single-host install. Change them only if something else
# owns the port; gate 0 checks every one of them.
#
# 6380 rather than 6379 on purpose: LiveKit keeps trunk and room state in this
# Redis (it is not a cache), and 6379 is commonly taken by a host Redis/Valkey.
REDIS_PORT=6380
LIVEKIT_API_PORT=7880
RTC_TCP_PORT=7881
RTC_UDP_PORT=7882
SIP_PORT=5060
SIP_TLS_PORT=5061

# The media range the carrier sends RTP to. Open exactly this range inbound in
# both firewall layers. Shrinking it is fine; forgetting it gives one-way audio.
RTP_PORT_RANGE=10000-10100

# Paths as seen INSIDE the sip container (bootstrap/cert-acme.sh writes them).
TLS_CERT_FILE=/certs/sip.crt
TLS_KEY_FILE=/certs/sip.key


# ============================================================== voice agent
# REQUIRED. Speech-to-speech model key. GEMINI_LIVE_API_KEY and GOOGLE_API_KEY
# are accepted as aliases.
# sample: AIza + 35 characters
GEMINI_API_KEY=

# Model and voice. gemini-3.8-live is the tested pairing with the pinned SDK.
# Note the free tier is bounded by TOKENS PER MINUTE, not requests: two
# overlapping live sessions trip error 1011 and the caller hears silence.
AGENT_S2S_MODEL=gemini-3.8-live
AGENT_S2S_VOICE=Puck

# Where the worker reports health (used by the ladder).
AGENT_WORKER_PORT=8083

# Free text the model is told it is assistant to. Neutral by default; put your
# own name here if you want the agent to introduce itself that way.
AGENT_OWNER_LABEL="the owner"

# The SIP participant identity the dialer uses for the phone leg. The worker
# waits for exactly this identity before speaking, so both sides read it here.
# Changing it after a call has been placed is harmless; changing it mid-call is
# not.
SIP_IDENTITY=phone-user
SIP_PARTICIPANT_NAME=Phone User

# One JSON-lines transcript per call, written here. Empty = <repo>/calls.
# The chat briefing and /calllog are built from these files, so the plugin and
# the worker must agree - the plugin reads this key from this file.
AGENT_CALL_LOG_DIR=


# ====================================================== how the agent behaves
# The floor on an outbound call: end_call is refused until the agent has spoken
# AND the line has been up this long. Without it, a model told to "wrap up" wraps
# up one second after the callee says hello.
AGENT_MIN_TALK_S=12

# A "this is a machine" verdict may end the call earlier than AGENT_MIN_TALK_S,
# but never before this. Anything sooner is impatience, not a voicemail.
AGENT_MACHINE_MIN_S=6

# Keep the line up briefly after end_call, so the farewell is not cut off.
AGENT_HANGUP_GRACE_S=3.5

# OPTIONAL. File of extra instructions appended to the persona prompt.
# sample: /home/you/persona.md
AGENT_PERSONA_FILE=

# OPTIONAL. First line of an inbound call. Empty = the model opens in its own
# words. A fixed line is worth it if your callers need to hear what they reached.
# sample: "Thanks for calling - how can I help?"
AGENT_INBOUND_GREETING=


# ================================================================= numbers
# Your own number, E.164. This is what /callme rings and the only number the
# owner shortcut accepts.
# sample (fiction range): +15555550100
OWNER_NUMBER=

# The provider's number: the caller ID outbound calls present, and the number the
# inbound trunk owns. Gate 2 reads it from the provider API when empty, but
# setting it explicitly makes the trunk's number list deterministic.
# sample (fiction range): +15555550100
SIP_INBOUND_NUMBER=

# Country code used to expand local-form numbers typed into /call or the dialer:
# with 61, 0456 789 012 becomes +61456789012. Leave empty to require full E.164.
# sample: 61 (Australia), 1 (US/Canada), 44 (UK)
DEFAULT_COUNTRY_CODE=61


# ============================================================ SIP objects
# Names the installer creates in LiveKit. Rename them here only if they clash
# with objects you already have; gate 2 and the ladder both read these.
SIP_INBOUND_TRUNK=photon-inbound
SIP_DISPATCH_RULE=photon-inbound
SIP_OUTBOUND_TRUNK=photon-outbound

# Rooms created for inbound calls get this prefix (the dispatch rule applies it).
ROOM_PREFIX=call-

# OPTIONAL. Restrict inbound calls to these carrier IPs/CIDRs, comma separated.
# Empty means: any source that can pass the trunk's digest challenge.
# sample: 203.0.113.0/24,198.51.100.7
SIP_ALLOWED_ADDRESSES=


# ======================================================= provider (Photon)
# A voice-eligible line is required: the provider profile must report
# lineCount > 0. A project with no line cannot make or take calls, and no script
# here can create one - that is an account step in the dashboard.
#
# sample: opaque key from the dashboard
PHOTON_API_KEY=
# sample: pho_prj_ + 26 characters (in the dashboard URL)
PHOTON_PROJECT_ID=
# sample: pho_vpf_ + 26 characters (in the dashboard URL)
PHOTON_VOICE_PROFILE_ID=

# GENERATED by gate 2 (the carrier credential, and what gate 3 hands to the
# provider). Do not edit by hand: the trunk and the provider must hold the same
# value, and the ladder compares them. To rotate, delete both and re-run gate 2
# then gate 3.
# sample: a stable local part such as photon-1a2b3c4d
SIP_INBOUND_USER=
# sample: 43 random characters
SIP_INBOUND_PASS=

# GENERATED by gate 3 (the credential the provider's SBC issues, plus the
# endpoint it chose). Written back here and compared by the ladder.
# sample: sip.provider.example:5061
SIP_OUTBOUND_HOST=
# sample: 5061
SIP_OUTBOUND_PORT=
# sample: tls (or tcp/udp)
SIP_OUTBOUND_TRANSPORT=
# sample: opaque, issued by the provider
SIP_OUTBOUND_USER=
# sample: 43 random characters
SIP_OUTBOUND_PASS=
# sample: the digest realm the provider challenges with
SIP_OUTBOUND_REALM=
# Informational: every endpoint the provider offered, "host:port/transport".
SIP_OUTBOUND_ALL_ENDPOINTS=


# ============================================================== delegation
# DANGEROUS, and OFF by default. When on, the agent may hand a live caller's
# request to a local agent session and speak the answer back - so an inbound
# caller can reach whatever that session can reach. Enabling this REQUIRES the
# allowlist below; leave it off unless you have thought about who can call you.
AGENT_DELEGATION_ENABLED=false

# Comma separated caller IDs allowed to delegate, compared on the last 9 digits
# because the caller ID a carrier delivers rarely matches how you typed it here.
# sample: +15555550100,+15555550101
AGENT_DELEGATION_ALLOWLIST=

# The local agent binary, session name and time limit used for delegation.
AGENT_HERMES_BIN=hermes
AGENT_HERMES_SESSION=phone
AGENT_HERMES_TIMEOUT=120
